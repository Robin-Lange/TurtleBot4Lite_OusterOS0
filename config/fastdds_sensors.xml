<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>udp_transport</transport_id>
                <type>UDPv4</type>
                <sendBufferSize>4194304</sendBufferSize>
                <receiveBufferSize>4194304</receiveBufferSize>
                <maxMessageSize>8192</maxMessageSize>
                <interfaceWhiteList>
                    <!-- Local loopback for intra-Jetson SLAM & Nav2 costmaps -->
                    <address>127.0.0.1</address>
                    <!-- Private Wi-Fi interface for streaming to Jetson AGX Orin -->
                    <address>192.168.0.151</address>
                    <address>192.168.0.100</address>
                    <address>192.168.1.100</address>
                </interfaceWhiteList>
            </transport_descriptor>
        </transport_descriptors>
        <participant profile_name="sensor_participant_profile" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>udp_transport</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
                <builtin>
                    <initialPeersList>
                        <!-- Localhost nodes on Jetson Orin Nano -->
                        <locator>
                            <udpv4>
                                <address>127.0.0.1</address>
                            </udpv4>
                        </locator>
                        <!-- Offboard Jetson AGX Orin over Wi-Fi -->
                        <locator>
                            <udpv4>
                                <address>192.168.0.10</address>
                            </udpv4>
                        </locator>
                    </initialPeersList>
                </builtin>
            </rtps>
        </participant>
    </profiles>
</dds>
