<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>shm_transport</transport_id>
                <type>SHM</type>
            </transport_descriptor>
            <transport_descriptor>
                <transport_id>udp_transport</transport_id>
                <type>UDPv4</type>
                <sendBufferSize>212992</sendBufferSize>
                <receiveBufferSize>212992</receiveBufferSize>
                <maxMessageSize>8192</maxMessageSize>
                <interfaceWhiteList>
                    <address>192.168.186.3</address>
                    <address>127.0.0.1</address>
                    <address>192.168.0.100</address>
                    <address>192.168.0.151</address>
                </interfaceWhiteList>
            </transport_descriptor>
        </transport_descriptors>
        <participant profile_name="domainparticipant_profile_name" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>shm_transport</transport_id>
                    <transport_id>udp_transport</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
                <builtin>
                    <discovery_config>
                        <leaseAnnouncement>
                            <sec>0</sec>
                            <nanosec>250000000</nanosec>
                        </leaseAnnouncement>
                        <initialAnnouncements>
                            <count>15</count>
                            <period>
                                <sec>0</sec>
                                <nanosec>50000000</nanosec>
                            </period>
                        </initialAnnouncements>
                    </discovery_config>
                    <metatrafficMulticastLocatorList>
                        <locator>
                            <udpv4>
                                <address>239.255.0.1</address>
                            </udpv4>
                        </locator>
                    </metatrafficMulticastLocatorList>
                    <initialPeersList>
                        <locator>
                            <udpv4>
                                <address>239.255.0.1</address>
                            </udpv4>
                        </locator>
                        <locator>
                            <udpv4>
                                <address>192.168.186.2</address>
                            </udpv4>
                        </locator>
                        <locator>
                            <udpv4>
                                <address>127.0.0.1</address>
                            </udpv4>
                        </locator>
                        <locator>
                            <udpv4>
                                <address>192.168.0.10</address>
                            </udpv4>
                        </locator>
                    </initialPeersList>
                </builtin>
            </rtps>
        </participant>
    </profiles>
</dds>
