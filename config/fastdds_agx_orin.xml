<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>udp_transport</transport_id>
                <type>UDPv4</type>
                <sendBufferSize>65536</sendBufferSize>
                <receiveBufferSize>65536</receiveBufferSize>
                <maxMessageSize>8192</maxMessageSize>
                <interfaceWhiteList>
                    <!-- AGX Orin USB-to-Ethernet Private Robot Link -->
                    <address>192.168.0.10</address>
                    <!-- Local loopback for intra-AGX communication -->
                    <address>127.0.0.1</address>
                </interfaceWhiteList>
            </transport_descriptor>
        </transport_descriptors>
        <participant profile_name="agx_unicast_participant" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>udp_transport</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
                <builtin>
                    <!-- Pure Unicast Discovery & Dataflow -->
                    <metatrafficUnicastLocatorList>
                        <locator>
                            <udpv4/>
                        </locator>
                    </metatrafficUnicastLocatorList>
                    <initialPeersList>
                        <!-- Localhost nodes on Jetson AGX Orin -->
                        <locator>
                            <udpv4>
                                <address>127.0.0.1</address>
                            </udpv4>
                        </locator>
                        <!-- Robot Jetson Orin Nano over TP-Link Wi-Fi -->
                        <locator>
                            <udpv4>
                                <address>192.168.0.100</address>
                            </udpv4>
                        </locator>
                        <locator>
                            <udpv4>
                                <address>192.168.1.100</address>
                            </udpv4>
                        </locator>
                    </initialPeersList>
                </builtin>
            </rtps>
        </participant>
    </profiles>
</dds>
